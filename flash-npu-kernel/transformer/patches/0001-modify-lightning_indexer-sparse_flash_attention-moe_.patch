+ __aicore__ inline T RoundUp(const T val, const T align) {
+     static_assert(std::is_arithmetic<T>::value, "T must be an arithmetic type");
+     if (align == 0 || val + align - 1 < val) {
+         return val;
+     }
+     return (val + align - 1) / align * align;
+ }
