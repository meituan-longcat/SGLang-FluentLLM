+ template <TemplateMC2TypeA2Class>
+ __aicore__ inline void MoeDistributeDispatchA2<TemplateMC2TypeA2Func>::SendToMoeExpert()
+ {
+     SyncAll<true>();
+     ConstructBatchWriteInfo();
+ 
+     if (aivId_ == 0) {
+         bufferChosenGlobal_(0) = bufferChosen_ ^ 1;
+     }
+ }
