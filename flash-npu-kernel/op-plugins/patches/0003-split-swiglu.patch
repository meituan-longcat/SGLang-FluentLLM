+++ b/op_plugin/ops/opapi/MlpSplitSwigluKernelNpu.cpp
@@ -0,0 +1,51 @@
+#include "op_plugin/OpApiInterface.h"
+#include "op_plugin/AclOpsInterface.h"
+#include "op_plugin/utils/op_api_common.h"
+
+namespace op_api {
+using npu_preparation = at_npu::native::OpPreparation;
+
+at::Tensor mlp_split_swiglu(const at::Tensor& x, const at::Tensor& group_list, int64_t local_exp_start, int64_t local_exp_end) {
+  if (x.dim() != 2) {
+    throw std::runtime_error("x must be a 2-D tensor.");
+  }
+  if (group_list.dim() != 1) {
+    throw std::runtime_error("group_list must be a 1-D tensor.");
+  }
+
+  int expertNum = group_list.sizes()[0];
+  if (local_exp_end == -1) {
+    local_exp_start = 0; 
+    local_exp_end = expertNum;
+  }
+  if (local_exp_end <= local_exp_start) {
+      throw std::runtime_error("Local expert start-end pos invalid.");
+  }
+
+  int xRows = x.sizes()[0];
+  int xCols = x.sizes()[1];
+  if ((xCols % 2) != 0) {
+    throw std::runtime_error("Input hidden must be divided by 2.");
+  }
+
+  auto outputSize = op_infer::array_to_small_vector({xRows, xCols / 2});
+  at::Tensor out = npu_preparation::apply_tensor_without_format(outputSize, x.options());
+  EXEC_NPU_CMD(aclnnMlpSplitSwiglu, x, group_list, local_exp_start, local_exp_end, out);
+  return out;
+}
+
+
+at::Tensor mlp_split_swiglu_dense(const at::Tensor& x) {
+  TORCH_CHECK(x.dim() == 2 , "x must be a 2d tensor.");
+
+  int xRows = x.sizes()[0];
+  int xCols = x.sizes()[1];
+  TORCH_CHECK((xCols % 2) == 0 , "Input hidden must be divided by 2.");
+
+  auto outputSize = op_infer::array_to_small_vector({xRows, xCols / 2});
+  at::Tensor out = npu_preparation::apply_tensor_without_format(outputSize, x.options());
+  EXEC_NPU_CMD(aclnnMlpSplitSwigluDense, x, out);
+  return out;
+}
+
+}  // namespace op_api
diff --git a/op_plugin/python/meta/_meta_registrations.py b/op_plugin/python/meta/_meta_registrations.py
index c1bddd9a..81a824c8 100644
--- a/op_plugin/python/meta/_meta_registrations.py
+++ b/op_plugin/python/meta/_meta_registrations.py
@@ -17,6 +17,20 @@ ATTR_DIM_LIMIT_QUANTCONV2D = 2
 m = Library("npu", "IMPL", "Meta")
 m_aten = Library("aten", "IMPL", "Meta")
 
+@impl(m, "mlp_split_swiglu")
+def meta_mlp_split_swiglu(
+    x, group_list, *, local_exp_start=0, local_exp_end=-1
+):
+    if x.dim() != 2:
+        raise RuntimeError(f"[{meta_mlp_split_swiglu.__name__}] Dim of x must be 2, got {x.dim()}D")
+    
+    token, hidden = x.shape
+
+    if hidden % 2 != 0:
+        raise RuntimeError(f"[{meta_mlp_split_swiglu.__name__}] Hidden size ({hidden}) must be divisible by 2")
+    
+    output_shape = [token, hidden // 2]
+    return torch.empty(output_shape, dtype=x.dtype, device="meta")      
 
