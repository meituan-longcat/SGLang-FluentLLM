+++ b/op_plugin/ops/opapi/ComputeNGramIdsKernelNpuOpApi.cpp
@@ -0,0 +1,42 @@
+#include "op_plugin/OpApiInterface.h"
+#include "op_plugin/utils/op_api_common.h"
+
+namespace op_api {
+
+at::Tensor mlp_compute_n_gram_ids(
+  const at::Tensor& oe_weights,
+  const at::Tensor& oe_mods,
+  const at::Tensor& over_embedding_input_ids,
+  const at::Tensor& ignore_token_flags,
+  const at::Tensor& oe_exclusive_req_len_sums,
+  const at::Tensor& oe_exclusive_oe_info_len_sums,
+  const at::Tensor& oe_exclusive_embeder_size_sums,
+  int64_t seq_len,
+  int64_t batch_size,
+  int64_t over_embedding_n,
+  int64_t over_embedding_k)
+{
+  // 构造输出tensor
+  std::vector<int64_t> shape = {seq_len, (over_embedding_n - 1) * over_embedding_k};
+  at::Tensor result = at_npu::native::OpPreparation::apply_tensor_with_format(
+    shape, oe_weights.options(), ACL_FORMAT_ND);
+
+  // 调用NPU算子接口，完成输出结果的计算
+  EXEC_NPU_CMD(aclnnMlpComputeNGramIds,
+               oe_weights,
+               oe_mods,
+               over_embedding_input_ids,
+               ignore_token_flags,
+               oe_exclusive_req_len_sums,
+               oe_exclusive_oe_info_len_sums,
+               oe_exclusive_embeder_size_sums,
+               seq_len,
+               batch_size,
+               over_embedding_n,
+               over_embedding_k,
+               result);
+
+  return result;
+}
+
+}  // namespace op_api
\ No newline at end of file
diff --git a/op_plugin/python/meta/_meta_registrations.py b/op_plugin/python/meta/_meta_registrations.py
index 47dc0a40..c1bddd9a 100644
--- a/op_plugin/python/meta/_meta_registrations.py
+++ b/op_plugin/python/meta/_meta_registrations.py
@@ -3517,3 +3517,19 @@ def npu_repeat_interleave_backward_int_meta(grad, x, repeats, dim=None):
     result = torch.empty_like(x)
 
     return result
+
+@impl(m, "mlp_compute_n_gram_ids")
+def meta_mlp_compute_n_gram_ids(
+        oe_weights,
+        oe_mods,
+        over_embedding_input_ids,
+        ignore_token_flags,
+        oe_exclusive_req_len_sums,
+        oe_exclusive_oe_info_len_sums,
+        oe_exclusive_embeder_size_sums,
+        seq_len,
+        batch_size,
+        over_embedding_n,
+        over_embedding_k):
+    output_shape = [seq_len, (over_embedding_n - 1) * over_embedding_k]
+    return torch.empty(output_shape, dtype=oe_weights.dtype, device="meta")
