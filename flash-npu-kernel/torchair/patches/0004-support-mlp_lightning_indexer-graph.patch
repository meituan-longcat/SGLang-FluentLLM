+import torch
+from torch.library import Library, impl
+import torch_npu
+import torchair
+from typing import Any, Dict, List, Tuple, Union, Callable, Optional
+from torchair._ge_concrete_graph.ge_ir_pb2 import GraphDef, OpDef, TensorDescriptor, TensorDef
+from torchair.ge._ge_graph import get_default_ge_graph, next_unique_name
+from torchair.ge._ge_graph import auto_convert_to_tensor
+from torchair.ge._ge_graph import Tensor, TensorSpec, DataType, TensorType
+from torchair.ge._ge_graph import compat_as_bytes, compat_as_bytes_list
+from torchair.ge._ge_graph import trans_to_list_list_int, trans_to_list_list_float
+from torchair.ge._ge_graph import get_invalid_desc
+from torchair._ge_concrete_graph.fx2ge_converter import register_fx_node_ge_converter
+from torchair._ge_concrete_graph import ge_apis as ge
+from torchair.ge import attr
+
+
+@register_fx_node_ge_converter(torch.ops.npu.mlp_lightning_indexer.default)
+def convert_mlp_lightning_indexer(
+    query: Tensor,
+    key: Tensor,
+    weights: Tensor,
+    *,
+    cur_seq_lengths_query: Optional[Tensor] = None,
+    cur_seq_lengths_key: Optional[Tensor] = None,
+    block_table: Optional[Tensor] = None,
+    init_tensor: Optional[Tensor] = None,
+    local_tensor: Optional[Tensor] = None,
+    layout_query: str = "BSND",
+    layout_kv: str = "PA_BSND",
+    sparse_count: int = 2048,
+    block_len: int = 1,
+    q_block_len: int = 1,
+    init_num: int = 0,
+    local_num: int = 0,
+    sparse_mode: int = 3,
+    pre_tokens: int = 2147483647,
+    next_tokens: int = 2147483647,
+    return_value: bool = False,
+    meta_outputs: TensorSpec = None,
+):
+    cur_seq_lengths_query  = ge.Cast(cur_seq_lengths_query, dst_type=DataType.DT_INT64)
+    cur_seq_lengths_key  = ge.Cast(cur_seq_lengths_key, dst_type=DataType.DT_INT64)
+    return torchair.ge.custom_op(
+        "MlpLightningIndexer",
+        inputs={"query": query,
+                "key": key,
+                "weights": weights,
+                "cur_seq_lengths_query": cur_seq_lengths_query,
+                "cur_seq_lengths_key": cur_seq_lengths_key,
+                "block_table": block_table,
+                "init_tensor": init_tensor,
+                "local_tensor": local_tensor,
+               },
+        attrs={"layout_query": attr.Str(layout_query),
+               "layout_kv": attr.Str(layout_kv),
+               "sparse_count": attr.Int(sparse_count),
+               "block_len": attr.Int(block_len),
+               "q_block_len": attr.Int(q_block_len),
+               "init_num": attr.Int(init_num),
+               "local_num": attr.Int(local_num),
+               "sparse_mode": attr.Int(sparse_mode),
+               "pre_tokens": attr.Int(pre_tokens),
+               "next_tokens": attr.Int(next_tokens),
+               "return_values": attr.Bool(return_value),
+               },
+        outputs=['sparse_indices',
+                 "sparse_values",
+                ]
+    )
