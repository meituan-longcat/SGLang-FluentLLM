/*!
 * \file get_out_cache_loc.asc
 * \brief In-place GetOutCacheLoc operator for Ascend NPU (dav-2201)
 *
 * Inverse of assign_req_to_token_pool: gathers contiguous segments out of
 * req_to_token (2D pool) into out_cache_loc (1D flat buffer).
 *
 * For each batch element idx:
 *   poolIdx       = req_pool_indices[idx]
 *   newComputeLen = new_compute_lens[idx]
 *   cacheLen      = cache_lens[poolIdx]
 *   dstOffset     = sum(new_compute_lens[0:idx])
 *   srcOffset     = poolIdx * poolLen + cacheLen
 *   out_cache_loc[dstOffset : dstOffset + newComputeLen] =
 *       req_to_token[poolIdx, cacheLen : cacheLen + newComputeLen]
 *
 * File layout (mirrors MTP op_host / op_kernel split for easy migration):
 *   - get_out_cache_loc_tilingdata.h : TilingData POD struct (shared)
 *   - get_out_cache_loc_tiling.h     : Host-side calc_tiling_data()
 *   - get_out_cache_loc_kernel.h     : Kernel class — verbatim from MTP
 *   - get_out_cache_loc_entry.h      : Direct-invoke __global__ entry glue
 *   - this file                      : PyTorch schema / validation / Meta /
 *                                      NPU dispatch
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"

#include "get_out_cache_loc_tiling.h"
#include "get_out_cache_loc_entry.h"

namespace flash {
namespace GetOutCacheLoc {

// 1. Register the operator's schema (in-place; mutates out_cache_loc)
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("npu_get_out_cache_loc(Tensor req_to_token, Tensor req_pool_indices, "
          "Tensor new_compute_lens, Tensor cache_lens, "
          "Tensor(a!) out_cache_loc, int bs) -> Tensor(a!)");
}

// 2. Input validation — called from the NPU dispatch (eager path); the Meta
//    impl below stays trivial so torch.compile tracing is not burdened.
static void check_inputs(const torch::Tensor &req_to_token,
                         const torch::Tensor &req_pool_indices,
                         const torch::Tensor &new_compute_lens,
                         const torch::Tensor &cache_lens,
                         const torch::Tensor &out_cache_loc,
                         int64_t bs)
{
    // Attr check
    TORCH_CHECK(bs > 0, "bs must be positive, got bs=", bs);

    // Rank check
    TORCH_CHECK(req_to_token.dim() == 2,
        "req_to_token must be 2D, got dim=", req_to_token.dim());
    TORCH_CHECK(req_pool_indices.dim() == 1,
        "req_pool_indices must be 1D, got dim=", req_pool_indices.dim());
    TORCH_CHECK(new_compute_lens.dim() == 1,
        "new_compute_lens must be 1D, got dim=", new_compute_lens.dim());
    TORCH_CHECK(cache_lens.dim() == 1,
        "cache_lens must be 1D, got dim=", cache_lens.dim());
    TORCH_CHECK(out_cache_loc.dim() == 1,
        "out_cache_loc must be 1D, got dim=", out_cache_loc.dim());

    // Dtype check
    auto dtype = req_to_token.scalar_type();
    TORCH_CHECK(dtype == torch::kInt64 || dtype == torch::kInt32,
        "Only int64 and int32 are supported, got ", dtype);
    TORCH_CHECK(req_pool_indices.scalar_type() == dtype &&
                new_compute_lens.scalar_type() == dtype &&
                cache_lens.scalar_type() == dtype &&
                out_cache_loc.scalar_type() == dtype,
        "All tensors must have the same dtype as req_to_token (", dtype, ").");

    // Cross-tensor shape check
    int64_t poolNum = req_to_token.size(0);
    int64_t poolLen = req_to_token.size(1);
    TORCH_CHECK(poolLen > 0, "req_to_token.size(1) (poolLen) must be > 0.");
    TORCH_CHECK(poolNum >= bs,
        "req_to_token.size(0) (", poolNum, ") must be >= bs (", bs, ").");
    TORCH_CHECK(req_pool_indices.size(0) >= bs,
        "req_pool_indices.size(0) (", req_pool_indices.size(0),
        ") must be >= bs (", bs, ").");
    TORCH_CHECK(new_compute_lens.size(0) >= bs,
        "new_compute_lens.size(0) (", new_compute_lens.size(0),
        ") must be >= bs (", bs, ").");
    // cache_lens is indexed via req_pool_indices values (not shape-derivable
    // statically); original MTP op_tiling doesn't check its size either.
}

// 3. Meta function: shape/dtype inference only — in-place op, output aliases
//    out_cache_loc, so just return it. No validation here.
torch::Tensor get_out_cache_loc_meta(const torch::Tensor & /*req_to_token*/,
                                      const torch::Tensor & /*req_pool_indices*/,
                                      const torch::Tensor & /*new_compute_lens*/,
                                      const torch::Tensor & /*cache_lens*/,
                                      torch::Tensor &out_cache_loc,
                                      int64_t /*bs*/)
{
    return out_cache_loc;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("npu_get_out_cache_loc", get_out_cache_loc_meta);
}

// 4. NPU dispatch function
torch::Tensor get_out_cache_loc_npu(const torch::Tensor &req_to_token,
                                     const torch::Tensor &req_pool_indices,
                                     const torch::Tensor &new_compute_lens,
                                     const torch::Tensor &cache_lens,
                                     torch::Tensor &out_cache_loc,
                                     int64_t bs)
{
    check_inputs(req_to_token, req_pool_indices, new_compute_lens, cache_lens,
                 out_cache_loc, bs);

    const c10::OptionalDeviceGuard guard(req_to_token.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t batchSize = bs;
    int64_t poolLen = req_to_token.size(1);
    int64_t elemSize = req_to_token.element_size();
    auto tl = calc_tiling_data(batchSize, poolLen, elemSize);

    auto rtt_ptr = (GM_ADDR)req_to_token.data_ptr();
    auto rpi_ptr = (GM_ADDR)req_pool_indices.data_ptr();
    auto ncl_ptr = (GM_ADDR)new_compute_lens.data_ptr();
    auto cl_ptr = (GM_ADDR)cache_lens.data_ptr();
    auto ocl_ptr = (GM_ADDR)out_cache_loc.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            req_to_token.scalar_type(), "get_out_cache_loc_npu",
            AT_DISPATCH_CASE(torch::kInt64, [&] {
                using scalar_t = int64_t;
                get_out_cache_loc<scalar_t>
                    <<<tl.usedCoreNum, nullptr, stream>>>(
                        rtt_ptr, rpi_ptr, ncl_ptr, cl_ptr, ocl_ptr, tl);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                get_out_cache_loc<scalar_t>
                    <<<tl.usedCoreNum, nullptr, stream>>>(
                        rtt_ptr, rpi_ptr, ncl_ptr, cl_ptr, ocl_ptr, tl);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("GetOutCacheLoc", acl_call);
    return out_cache_loc;
}

// Register the NPU implementation
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("npu_get_out_cache_loc", get_out_cache_loc_npu);
}

} // namespace GetOutCacheLoc
} // namespace flash
