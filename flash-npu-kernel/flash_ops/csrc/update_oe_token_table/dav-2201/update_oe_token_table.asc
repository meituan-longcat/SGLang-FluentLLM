/*!
 * \file update_oe_token_table.asc
 * \brief In-place UpdateOeTokenTable operator for Ascend NPU (dav-2201)
 *
 * Writes `tokens` into `oe_token_table` at positions derived from
 * (row_indices, column_starts, req_lens), then replaces any entry equal to
 * one of `ignore_tokens` with -1.
 *
 *   For batch element idx (0 <= idx < bs):
 *     row    = row_indices[idx]
 *     col0   = column_starts[idx]
 *     len    = req_lens[idx]
 *     srcOff = sum(req_lens[0:idx])
 *     oe_token_table[row, col0:col0+len] = tokens[srcOff:srcOff+len]
 *   Post-pass: oe_token_table[oe_token_table in ignore_tokens] = -1
 *
 * File layout (mirrors op_host / op_kernel split for easy migration):
 *   - update_oe_token_table_tilingdata.h : TilingData POD struct (shared)
 *   - update_oe_token_table_tiling.h     : Host-side calc_tiling_data()
 *   - update_oe_token_table_kernel.h     : Kernel class — verbatim
 *   - update_oe_token_table_entry.h      : Direct-invoke __global__ entry glue
 *   - this file                          : PyTorch schema / validation /
 *                                          Meta / NPU dispatch
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"

#include "update_oe_token_table_tiling.h"
#include "update_oe_token_table_entry.h"

namespace flash {
namespace UpdateOeTokenTable {

// 1. Register the operator's schema (in-place; mutates oe_token_table)
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("npu_update_oe_token_table(Tensor tokens, Tensor req_lens, "
          "Tensor row_indices, Tensor column_starts, Tensor ignore_tokens, "
          "int batch_size, int max_context_len, "
          "Tensor(a!) oe_token_table) -> Tensor(a!)");
}

// 2. Input validation — called from the NPU dispatch (eager path); the Meta
//    impl below stays trivial so torch.compile tracing is not burdened.
static void check_inputs(const torch::Tensor &tokens,
                         const torch::Tensor &req_lens,
                         const torch::Tensor &row_indices,
                         const torch::Tensor &column_starts,
                         const torch::Tensor &ignore_tokens,
                         int64_t batch_size,
                         int64_t max_context_len,
                         const torch::Tensor &oe_token_table)
{
    // Attr check
    TORCH_CHECK(batch_size > 0,
        "batch_size must be positive, got batch_size=", batch_size);
    TORCH_CHECK(max_context_len > 0,
        "max_context_len must be positive, got max_context_len=", max_context_len);

    // Rank check
    TORCH_CHECK(tokens.dim() == 1,
        "tokens must be 1D, got dim=", tokens.dim());
    TORCH_CHECK(req_lens.dim() == 1,
        "req_lens must be 1D, got dim=", req_lens.dim());
    TORCH_CHECK(row_indices.dim() == 1,
        "row_indices must be 1D, got dim=", row_indices.dim());
    TORCH_CHECK(column_starts.dim() == 1,
        "column_starts must be 1D, got dim=", column_starts.dim());
    TORCH_CHECK(ignore_tokens.dim() == 1,
        "ignore_tokens must be 1D, got dim=", ignore_tokens.dim());
    TORCH_CHECK(oe_token_table.dim() == 2,
        "oe_token_table must be 2D, got dim=", oe_token_table.dim());

    // Dtype check — original op_host declares int32 for all i/o except
    // row_indices which is int64.
    TORCH_CHECK(tokens.scalar_type() == torch::kInt32,
        "tokens must be int32, got ", tokens.scalar_type());
    TORCH_CHECK(req_lens.scalar_type() == torch::kInt32,
        "req_lens must be int32, got ", req_lens.scalar_type());
    TORCH_CHECK(row_indices.scalar_type() == torch::kInt64,
        "row_indices must be int64, got ", row_indices.scalar_type());
    TORCH_CHECK(column_starts.scalar_type() == torch::kInt32,
        "column_starts must be int32, got ", column_starts.scalar_type());
    TORCH_CHECK(ignore_tokens.scalar_type() == torch::kInt32,
        "ignore_tokens must be int32, got ", ignore_tokens.scalar_type());
    TORCH_CHECK(oe_token_table.scalar_type() == torch::kInt32,
        "oe_token_table must be int32, got ", oe_token_table.scalar_type());

    // Cross-tensor shape check
    TORCH_CHECK(req_lens.size(0) >= batch_size,
        "req_lens.size(0) (", req_lens.size(0),
        ") must be >= batch_size (", batch_size, ").");
    TORCH_CHECK(row_indices.size(0) >= batch_size,
        "row_indices.size(0) (", row_indices.size(0),
        ") must be >= batch_size (", batch_size, ").");
    TORCH_CHECK(column_starts.size(0) >= batch_size,
        "column_starts.size(0) (", column_starts.size(0),
        ") must be >= batch_size (", batch_size, ").");
    TORCH_CHECK(ignore_tokens.size(0) > 0,
        "ignore_tokens must have at least one element.");
    TORCH_CHECK(oe_token_table.size(1) == max_context_len,
        "oe_token_table.size(1) (", oe_token_table.size(1),
        ") must equal max_context_len (", max_context_len, ").");
}

// 3. Meta function: shape/dtype inference only — in-place op, return the
//    mutated tensor so PyTorch tracks the aliasing/version correctly.
torch::Tensor update_oe_token_table_meta(const torch::Tensor & /*tokens*/,
                                          const torch::Tensor & /*req_lens*/,
                                          const torch::Tensor & /*row_indices*/,
                                          const torch::Tensor & /*column_starts*/,
                                          const torch::Tensor & /*ignore_tokens*/,
                                          int64_t /*batch_size*/,
                                          int64_t /*max_context_len*/,
                                          torch::Tensor &oe_token_table)
{
    return oe_token_table;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("npu_update_oe_token_table", update_oe_token_table_meta);
}

// 4. NPU dispatch function
torch::Tensor update_oe_token_table_npu(const torch::Tensor &tokens,
                                 const torch::Tensor &req_lens,
                                 const torch::Tensor &row_indices,
                                 const torch::Tensor &column_starts,
                                 const torch::Tensor &ignore_tokens,
                                 int64_t batch_size,
                                 int64_t max_context_len,
                                 torch::Tensor &oe_token_table)
{
    check_inputs(tokens, req_lens, row_indices, column_starts, ignore_tokens,
                 batch_size, max_context_len, oe_token_table);

    const c10::OptionalDeviceGuard guard(oe_token_table.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t ignore_token_num = ignore_tokens.size(0);
    auto tl = calc_tiling_data(batch_size, max_context_len, ignore_token_num);

    auto tokens_ptr = (GM_ADDR)tokens.data_ptr();
    auto req_lens_ptr = (GM_ADDR)req_lens.data_ptr();
    auto row_indices_ptr = (GM_ADDR)row_indices.data_ptr();
    auto column_starts_ptr = (GM_ADDR)column_starts.data_ptr();
    auto ignore_tokens_ptr = (GM_ADDR)ignore_tokens.data_ptr();
    auto oe_token_table_ptr = (GM_ADDR)oe_token_table.data_ptr();
    GM_ADDR workspace_ptr = nullptr;

    auto acl_call = [=]() -> int {
        update_oe_token_table<<<tl.usedCoreNum, nullptr, stream>>>(
            tokens_ptr, req_lens_ptr, row_indices_ptr, column_starts_ptr,
            ignore_tokens_ptr, oe_token_table_ptr, workspace_ptr, tl);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("UpdateOeTokenTable", acl_call);
    return oe_token_table;
}

// Register the NPU implementation
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("npu_update_oe_token_table", update_oe_token_table_npu);
}

} // namespace UpdateOeTokenTable
} // namespace flash
