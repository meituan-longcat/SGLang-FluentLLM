/*!
 * \file rearrange_accept_index.asc
 * \brief In-place RearrangeAcceptIndex operator for Ascend NPU (dav-2201)
 *
 * Flattens accept_index[bs, poolLen] into a contiguous output buffer,
 * keeping only the first accept_length[i] elements of each row:
 *
 *   dstOffset_i = sum(accept_length[0:i])
 *   output[dstOffset_i : dstOffset_i + accept_length[i]] =
 *       accept_index[i, 0 : accept_length[i]]
 *
 * File layout (mirrors MTP op_host / op_kernel split for easy migration):
 *   - rearrange_accept_index_tilingdata.h : TilingData POD struct (shared)
 *   - rearrange_accept_index_tiling.h     : Host-side calc_tiling_data()
 *   - rearrange_accept_index_kernel.h     : Kernel class — verbatim from MTP
 *   - rearrange_accept_index_entry.h      : Direct-invoke __global__ entry glue
 *   - this file                           : PyTorch schema / validation /
 *                                           Meta / NPU dispatch
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"

#include "rearrange_accept_index_tiling.h"
#include "rearrange_accept_index_entry.h"

namespace flash {
namespace RearrangeAcceptIndex {

// 1. Register the operator's schema (in-place; mutates output)
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("npu_rearrange_accept_index(Tensor accept_index, Tensor accept_length, "
          "int bs, Tensor(a!) output) -> Tensor(a!)");
}

// 2. Input validation — called from the NPU dispatch (eager path); the Meta
//    impl below stays trivial so torch.compile tracing is not burdened.
static void check_inputs(const torch::Tensor &accept_index,
                         const torch::Tensor &accept_length,
                         const torch::Tensor &output,
                         int64_t bs)
{
    // Attr check
    TORCH_CHECK(bs > 0, "bs must be positive, got bs=", bs);

    // Rank check
    TORCH_CHECK(accept_index.dim() == 2,
        "accept_index must be 2D, got dim=", accept_index.dim());
    TORCH_CHECK(accept_length.dim() == 1,
        "accept_length must be 1D, got dim=", accept_length.dim());
    TORCH_CHECK(output.dim() == 1,
        "output must be 1D, got dim=", output.dim());

    // Dtype check
    auto dtype = accept_index.scalar_type();
    TORCH_CHECK(dtype == torch::kInt64 || dtype == torch::kInt32,
        "Only int64 and int32 are supported, got ", dtype);
    TORCH_CHECK(accept_length.scalar_type() == dtype &&
                output.scalar_type() == dtype,
        "All tensors must have the same dtype as accept_index (", dtype, ").");

    // Cross-tensor shape check
    int64_t poolLen = accept_index.size(1);
    TORCH_CHECK(poolLen > 0, "accept_index.size(1) (poolLen) must be > 0.");
    TORCH_CHECK(accept_index.size(0) >= bs,
        "accept_index.size(0) (", accept_index.size(0),
        ") must be >= bs (", bs, ").");
    TORCH_CHECK(accept_length.size(0) >= bs,
        "accept_length.size(0) (", accept_length.size(0),
        ") must be >= bs (", bs, ").");
}

// 3. Meta function: shape/dtype inference only — in-place op, output aliases
//    the mutable tensor, so just return it. No validation here.
torch::Tensor rearrange_accept_index_meta(const torch::Tensor & /*accept_index*/,
                                           const torch::Tensor & /*accept_length*/,
                                           int64_t /*bs*/,
                                           torch::Tensor &output)
{
    return output;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("npu_rearrange_accept_index", rearrange_accept_index_meta);
}

// 4. NPU dispatch function
torch::Tensor rearrange_accept_index_npu(const torch::Tensor &accept_index,
                                          const torch::Tensor &accept_length,
                                          int64_t bs,
                                          torch::Tensor &output)
{
    check_inputs(accept_index, accept_length, output, bs);

    const c10::OptionalDeviceGuard guard(accept_index.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t batchSize = bs;
    int64_t poolLen = accept_index.size(1);
    int64_t elemSize = accept_index.element_size();
    auto tl = calc_tiling_data(batchSize, poolLen, elemSize);

    auto ai_ptr = (GM_ADDR)accept_index.data_ptr();
    auto al_ptr = (GM_ADDR)accept_length.data_ptr();
    auto out_ptr = (GM_ADDR)output.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            accept_index.scalar_type(), "rearrange_accept_index_npu",
            AT_DISPATCH_CASE(torch::kInt64, [&] {
                using scalar_t = int64_t;
                rearrange_accept_index<scalar_t>
                    <<<tl.usedCoreNum, nullptr, stream>>>(
                        ai_ptr, al_ptr, out_ptr, tl);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                rearrange_accept_index<scalar_t>
                    <<<tl.usedCoreNum, nullptr, stream>>>(
                        ai_ptr, al_ptr, out_ptr, tl);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("RearrangeAcceptIndex", acl_call);
    return output;
}

// Register the NPU implementation
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("npu_rearrange_accept_index", rearrange_accept_index_npu);
}

} // namespace RearrangeAcceptIndex
} // namespace flash
