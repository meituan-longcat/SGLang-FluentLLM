#include <algorithm>
#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "platform/platform_ascendc.h"
#include "index_k_route_stats_kernel.h"

namespace flash::IndexKRouteStats {
static void check(const torch::Tensor& groups, const torch::Tensor& lengths,
                  const torch::Tensor& pages, int64_t num_groups, int64_t reserved) {
    TORCH_CHECK(num_groups > 0 && num_groups <= 256, "num_groups must be in [1, 256]");
    TORCH_CHECK(reserved >= 0, "reserved must be nonnegative");
    for (const auto& input : {groups, lengths, pages}) {
        TORCH_CHECK(input.dim() == 1 && input.is_contiguous(), "inputs must be contiguous vectors");
        TORCH_CHECK(input.scalar_type() == torch::kInt64, "inputs must be int64");
        TORCH_CHECK(input.device() == groups.device(), "inputs must be on the same device");
        TORCH_CHECK(input.numel() == groups.numel(), "inputs must have equal lengths");
    }
}

torch::Tensor meta(const torch::Tensor& groups, const torch::Tensor& lengths,
                   const torch::Tensor& pages, int64_t num_groups, int64_t reserved) {
    check(groups, lengths, pages, num_groups, reserved);
    return torch::empty({2 * num_groups + 1}, groups.options());
}

torch::Tensor npu(const torch::Tensor& groups, const torch::Tensor& lengths,
                  const torch::Tensor& pages, int64_t num_groups, int64_t reserved) {
    check(groups, lengths, pages, num_groups, reserved);
    const c10::OptionalDeviceGuard guard(groups.device());
    auto* platform = platform_ascendc::PlatformAscendCManager::GetInstance();
    TORCH_CHECK(platform != nullptr, "Ascend platform is unavailable");
    uint64_t ub = 0;
    platform->GetCoreMemSize(platform_ascendc::CoreMemType::UB, ub);
    const uint32_t cores = std::min<int64_t>(
        std::min<int64_t>(platform->GetCoreNumAiv(), 32),
        std::max<int64_t>(1, (groups.numel() + 127) / 128));
    TORCH_CHECK(cores > 0, "No AIV cores available");
    const uint32_t stride = ((2 * num_groups + 1 + 3) / 4) * 4;
    TORCH_CHECK((3 * TILE + stride) * sizeof(int64_t) <= ub &&
                uint64_t(4) * (cores + 1) * sizeof(int64_t) <= ub,
                "Index-K statistics UB budget exceeded");
    Tiling t{groups.numel(), reserved, uint32_t(num_groups), cores, stride};
    auto output = torch::empty({2 * num_groups + 1}, groups.options());
    auto partial = cores == 1 ? output :
        torch::empty({int64_t(cores), int64_t(stride)}, groups.options());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto gp = (GM_ADDR)groups.data_ptr();
    auto lp = (GM_ADDR)lengths.data_ptr();
    auto pp = (GM_ADDR)pages.data_ptr();
    auto tmp = (GM_ADDR)partial.data_ptr();
    auto out = (GM_ADDR)output.data_ptr();
    auto launch = [=]() -> int {
        partial_stats<<<cores, nullptr, stream>>>(gp, lp, pp, tmp, t);
        if (cores > 1) {
            finish_stats<<<(2 * num_groups + 4) / 4, nullptr, stream>>>(tmp, out, t);
        }
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("IndexKRouteStats", launch);
    return output;
}

TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m) {
    m.def("npu_index_k_route_stats(Tensor groups, Tensor lengths, Tensor pages, int num_groups, int reserved) -> Tensor");
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m) {
    m.impl("npu_index_k_route_stats", meta);
}
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m) {
    m.impl("npu_index_k_route_stats", npu);
}
}  // namespace flash::IndexKRouteStats
