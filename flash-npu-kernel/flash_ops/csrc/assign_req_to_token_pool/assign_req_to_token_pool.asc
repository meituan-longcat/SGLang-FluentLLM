/*!
 * \file assign_req_to_token_pool.asc
 * \brief In-place AssignReqToTokenPool operator for Ascend NPU (dav-2201)
 *
 * File layout (mirrors MTP op_host / op_kernel split for easy migration):
 *   - assign_req_to_token_pool_tilingdata.h : TilingData POD struct (shared
 *                                              by kernel and host)
 *   - assign_req_to_token_pool_tiling.h     : Host-side calc_tiling_data()
 *                                              (BlockTiling + UbTiling logic
 *                                              from MTP op_tiling)
 *   - assign_req_to_token_pool_kernel.h     : Kernel class — verbatim from MTP
 *                                              op_kernel/.../assign_req_to_token_pool.h
 *   - assign_req_to_token_pool_entry.h      : Direct-invoke __global__ entry
 *                                              glue (counterpart of MTP's
 *                                              extern "C" kernel .cpp)
 *   - this file                             : PyTorch schema / validation /
 *                                              Meta / NPU dispatch
 */

#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"

#include "assign_req_to_token_pool_tiling.h"
#include "assign_req_to_token_pool_entry.h"

namespace flash {
namespace AssignReqToTokenPool {

// 1. Register the operator's schema (in-place; mutates req_to_token_pool)
TORCH_LIBRARY_FRAGMENT(EXTENSION_MODULE_NAME, m)
{
    m.def("npu_assign_req_to_token_pool(Tensor req_pool_indices, Tensor extend_lens, "
          "Tensor alloced_lens, Tensor out_cache_loc, Tensor(a!) req_to_token_pool, "
          "int bs) -> Tensor(a!)");
}

// 2. Input validation — mirrors MTP op_tiling's GetPlatformInfo() dtype check
//    + GetShapeAttrsInfo() shape check, plus cross-tensor rank/size checks
//    absent in the original. Called from the NPU dispatch (eager path); the
//    Meta impl below stays trivial so torch.compile tracing is not burdened.
static void check_inputs(const torch::Tensor &req_pool_indices,
                         const torch::Tensor &extend_lens,
                         const torch::Tensor &alloced_lens,
                         const torch::Tensor &out_cache_loc,
                         const torch::Tensor &req_to_token_pool,
                         int64_t bs)
{
    // Attr check
    TORCH_CHECK(bs > 0, "bs must be positive, got bs=", bs);

    // Rank check
    TORCH_CHECK(req_pool_indices.dim() == 1,
        "req_pool_indices must be 1D, got dim=", req_pool_indices.dim());
    TORCH_CHECK(extend_lens.dim() == 1,
        "extend_lens must be 1D, got dim=", extend_lens.dim());
    TORCH_CHECK(alloced_lens.dim() == 1,
        "alloced_lens must be 1D, got dim=", alloced_lens.dim());
    TORCH_CHECK(out_cache_loc.dim() == 1,
        "out_cache_loc must be 1D, got dim=", out_cache_loc.dim());
    TORCH_CHECK(req_to_token_pool.dim() == 2,
        "req_to_token_pool must be 2D, got dim=", req_to_token_pool.dim());

    // Dtype check
    auto dtype = req_to_token_pool.scalar_type();
    TORCH_CHECK(dtype == torch::kInt64 || dtype == torch::kInt32,
        "Only int64 and int32 are supported, got ", dtype);
    TORCH_CHECK(req_pool_indices.scalar_type() == dtype &&
                extend_lens.scalar_type() == dtype &&
                alloced_lens.scalar_type() == dtype &&
                out_cache_loc.scalar_type() == dtype,
        "All tensors must have the same dtype as req_to_token_pool (", dtype, ").");

    // Cross-tensor shape check
    int64_t poolNum = req_to_token_pool.size(0);
    int64_t poolLen = req_to_token_pool.size(1);
    TORCH_CHECK(poolLen > 0, "req_to_token_pool.size(1) (poolLen) must be > 0.");
    TORCH_CHECK(poolNum >= bs,
        "req_to_token_pool.size(0) (", poolNum, ") must be >= bs (", bs, ").");
    TORCH_CHECK(req_pool_indices.size(0) >= bs,
        "req_pool_indices.size(0) (", req_pool_indices.size(0),
        ") must be >= bs (", bs, ").");
    TORCH_CHECK(extend_lens.size(0) >= bs,
        "extend_lens.size(0) (", extend_lens.size(0),
        ") must be >= bs (", bs, ").");
    // alloced_lens is indexed via req_pool_indices values (not shape-derivable
    // statically); original MTP op_tiling doesn't check its size either.
}

// 3. Meta function: shape/dtype inference only — in-place op, output aliases
//    req_to_token_pool, so just return it. No validation here (keeps
//    torch.compile / FakeTensor tracing light).
torch::Tensor assign_req_to_token_pool_meta(const torch::Tensor & /*req_pool_indices*/,
                                             const torch::Tensor & /*extend_lens*/,
                                             const torch::Tensor & /*alloced_lens*/,
                                             const torch::Tensor & /*out_cache_loc*/,
                                             torch::Tensor &req_to_token_pool,
                                             int64_t /*bs*/)
{
    return req_to_token_pool;
}

TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, Meta, m)
{
    m.impl("npu_assign_req_to_token_pool", assign_req_to_token_pool_meta);
}

// 4. NPU dispatch function
torch::Tensor assign_req_to_token_pool_npu(const torch::Tensor &req_pool_indices,
                                            const torch::Tensor &extend_lens,
                                            const torch::Tensor &alloced_lens,
                                            const torch::Tensor &out_cache_loc,
                                            torch::Tensor &req_to_token_pool,
                                            int64_t bs)
{
    check_inputs(req_pool_indices, extend_lens, alloced_lens, out_cache_loc,
                 req_to_token_pool, bs);

    const c10::OptionalDeviceGuard guard(req_to_token_pool.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);

    int64_t batchSize = bs;
    int64_t poolLen = req_to_token_pool.size(1);
    int64_t elemSize = req_to_token_pool.element_size();
    auto tl = calc_tiling_data(batchSize, poolLen, elemSize);

    auto rpi_ptr = (GM_ADDR)req_pool_indices.data_ptr();
    auto el_ptr = (GM_ADDR)extend_lens.data_ptr();
    auto al_ptr = (GM_ADDR)alloced_lens.data_ptr();
    auto ocl_ptr = (GM_ADDR)out_cache_loc.data_ptr();
    auto rttp_ptr = (GM_ADDR)req_to_token_pool.data_ptr();

    auto acl_call = [=]() -> int {
        AT_DISPATCH_SWITCH(
            req_to_token_pool.scalar_type(), "npu_assign_req_to_token_poolnpu",
            AT_DISPATCH_CASE(torch::kInt64, [&] {
                using scalar_t = int64_t;
                assign_req_to_token_pool<scalar_t>
                    <<<tl.usedCoreNum, nullptr, stream>>>(
                        rpi_ptr, el_ptr, al_ptr, ocl_ptr, rttp_ptr, tl);
            })
            AT_DISPATCH_CASE(torch::kInt32, [&] {
                using scalar_t = int32_t;
                assign_req_to_token_pool<scalar_t>
                    <<<tl.usedCoreNum, nullptr, stream>>>(
                        rpi_ptr, el_ptr, al_ptr, ocl_ptr, rttp_ptr, tl);
            })
        );
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("AssignReqToTokenPool", acl_call);
    return req_to_token_pool;
}

// Register the NPU implementation
TORCH_LIBRARY_IMPL(EXTENSION_MODULE_NAME, PrivateUse1, m)
{
    m.impl("npu_assign_req_to_token_pool", assign_req_to_token_pool_npu);
}

} // namespace AssignReqToTokenPool
} // namespace flash
